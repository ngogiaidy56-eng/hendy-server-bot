# Local development only. Never commit .env.
NODE_ENV=development
PORT=3000

# Telegram BotFather token. Rotate any token previously committed to Git.
TELEGRAM_BOT_TOKEN=
# 1-256 chars; only letters, digits, underscore and hyphen.
TELEGRAM_WEBHOOK_SECRET=

# Public Render HTTPS base URL; Render may provide RENDER_EXTERNAL_URL automatically.
WEBHOOK_BASE_URL=
# Cloudflare Pages Mini App URL.
MINI_APP_URL=
APP_URL=
CORS_ALLOWED_ORIGINS=

# Cloudflare Data Worker URL and its shared internal Bearer token.
CLOUDFLARE_DATA_API_URL=
CLOUDFLARE_DATA_API_TOKEN=

# Protects admin mutations under /api/store. Never put this in browser code.
ADMIN_API_TOKEN=

# Optional Google AI integration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Unique secret for server-side encryption.
ENCRYPTION_SECRET=
